{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustlens.io/schemas/root_store_record.schema.json",
  "title": "TrustLensRootStoreRecord",
  "description": "Standardized schema for root certificates in authoritative trust stores.",
  "type": "object",
  "required": [
    "root_sha256_fingerprint",
    "store_name",
    "store_version",
    "subject_dn",
    "issuer_dn",
    "spki_sha256_fingerprint",
    "public_key_algorithm",
    "key_size_bits",
    "trust_purposes",
    "retrieval_date",
    "policy_version"
  ],
  "properties": {
    "root_sha256_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "store_name": {
      "type": "string",
      "enum": ["MOZILLA", "GOOGLE_CHROME", "MICROSOFT", "APPLE"]
    },
    "store_version": { "type": "string" },
    "subject_dn": { "type": "string" },
    "issuer_dn": { "type": "string" },
    "common_name": { "type": ["string", "null"] },
    "organization": { "type": ["string", "null"] },
    "spki_sha256_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "public_key_algorithm": { "type": "string" },
    "key_size_bits": { "type": "integer", "minimum": 0 },
    "trust_purposes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["SERVER_AUTH", "CLIENT_AUTH", "CODE_SIGNING", "EMAIL_PROTECTION", "TIME_STAMPING"]
      }
    },
    "trust_bits": {
      "type": "object",
      "properties": {
        "server_auth": { "type": "boolean" },
        "email_protection": { "type": "boolean" },
        "code_signing": { "type": "boolean" }
      }
    },
    "ev_capable": { "type": "boolean" },
    "retrieval_date": { "type": "string", "format": "date-time" },
    "policy_version": { "type": "string" },
    "der_base64": { "type": "string" }
  },
  "additionalProperties": false
}

