# ==============================================================================
# TrustLens Backend Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Core Application Settings
ENVIRONMENT=development
DEBUG=false
PROJECT_NAME="TrustLens Security Platform"
API_V1_PREFIX="/api/v1"

# Security & Cryptography
# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL)
# Async URL for FastAPI (asyncpg)
DATABASE_URL=postgresql+asyncpg://trustlens_user:trustlens_password@localhost:5432/trustlens_db
# Sync URL for Alembic migrations and synchronous scripts (psycopg)
DATABASE_SYNC_URL=postgresql+psycopg://trustlens_user:trustlens_password@localhost:5432/trustlens_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS Allowlist (JSON array format)
ALLOWED_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Website Scanning Boundaries & SSRF Safeguards
SCAN_TIMEOUT_SECONDS=10
SCAN_CONNECT_TIMEOUT_SECONDS=3
SCAN_MAX_REDIRECTS=5
SCAN_MAX_BODY_BYTES=131072
SCAN_ALLOWED_PORTS=[80,443]

# Rate Limiting Controls
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_SCAN_PER_MINUTE=10

# Third-party Threat Intelligence (Optional / Feature Flagged)
URLHAUS_AUTH_KEY=
OPENPHISH_ENABLED=true

